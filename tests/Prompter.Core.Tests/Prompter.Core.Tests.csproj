<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Deliberately compiles the pure Core domain/storage layer directly from src/Core
    rather than referencing the file-based prompter.cs app. prompter.cs is a genuine
    file-based app (no traditional csproj), so it is not project-referenceable; Core has
    no dependency on Hex1b or the CLI/TUI layers, so this keeps the tests fast, simple,
    and focused on pure logic without needing to convert the app itself.
  -->
  <ItemGroup>
    <Compile Include="../../src/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>
